#include <stdio.h>
#include <time.h>
#include <string.h>
#include <stdlib.h>
#include <ctype.h>

#define MAX_ACCOUNTS 1000
#define MAX_HISTORY 100
#define DATA_FILE "bank.dat"
#define ADMIN_FILE "admin.dat"
#define SAVINGS_RATE 5.0f
#define LOAN_LIMIT_TIMES 2

struct Transaction {
    char AccountType[20];
    float cash;
    char date[100];
};

struct Accounts {
    int accountnumber;
    char Name[100];
    int PIN;
    float cash;
    float loan;
    char accountype[20];
    char CNIC[100];
    char Email[100];
    char Phone[20];
    struct Transaction History[MAX_HISTORY];
    int HistoryCount;
    float InterestRate;
    int YearsActive;
    int Active;
};

struct Admin {
    char username[50];
    unsigned int passwordHash;
};

struct Admin admin;
struct Accounts Bank[MAX_ACCOUNTS];
int Available = MAX_ACCOUNTS;
int count = 0;

void readLine(char *buffer, int size) {
    if (fgets(buffer, size, stdin) == NULL) {

        printf("\nInput closed. Exiting.\n");
        exit(0);
    }
    buffer[strcspn(buffer, "\n")] = '\0';
}

float readFloat() {
    char line[100];
    char *end;
    float value;
    while (1) {
        readLine(line, sizeof(line));
        value = strtof(line, &end);
        if (end != line && *end == '\0') {
            return value;
        }
        printf("Invalid number. Enter again:\n");
    }
}

int readInt() {
    char line[100];
    char *end;
    long value;
    while (1) {
        readLine(line, sizeof(line));
        value = strtol(line, &end, 10);
        if (end != line && *end == '\0') {
            return (int)value;
        }
        printf("Invalid number. Enter again:\n");
    }
}

int onlyDigits(const char *s) {
    if (s[0] == '\0') return 0;
    for (int i = 0; s[i] != '\0'; i++) {
        if (s[i] < '0' || s[i] > '9') return 0;
    }
    return 1;
}

int validGmail(const char *email) {
    int len = strlen(email);
    if (len <= 10) return 0;
    return strcmp(&email[len - 10], "@gmail.com") == 0;
}

int containsIgnoreCase(const char *text, const char *needle) {
    int n = strlen(needle);
    int t = strlen(text);
    if (n == 0) return 0;
    for (int i = 0; i + n <= t; i++) {
        int j;
        for (j = 0; j < n; j++) {
            if (tolower((unsigned char)text[i + j]) != tolower((unsigned char)needle[j])) break;
        }
        if (j == n) return 1;
    }
    return 0;
}

int confirm(const char *question) {
    char line[20];
    printf("%s (y/n):\n", question);
    readLine(line, sizeof(line));
    return tolower((unsigned char)line[0]) == 'y';
}

void promptName(char *dest, int size) {
    printf("Enter the Name for the Account: \n");
    readLine(dest, size);
    while (dest[0] == '\0') {
        printf("Name cannot be empty. Enter again:\n");
        readLine(dest, size);
    }
}

void promptCNIC(char *dest, int size) {
    printf("Enter your CNIC (13 digits, no dashes):\n");
    readLine(dest, size);
    while (!onlyDigits(dest) || strlen(dest) != 13) {
        printf("Invalid CNIC. Enter numbers only and exactly 13 digits:\n");
        readLine(dest, size);
    }
}

void promptEmail(char *dest, int size) {
    printf("Enter your email address (Gmail only): \n");
    readLine(dest, size);
    while (!validGmail(dest)) {
        printf("Invalid Email Address. Enter again:\n");
        readLine(dest, size);
    }
}

void promptPhone(char *dest, int size) {
    printf("Enter your phone number (digits only, 10 to 15 digits):\n");
    readLine(dest, size);
    while (!onlyDigits(dest) || strlen(dest) < 10 || strlen(dest) > 15) {
        printf("Invalid phone number. Enter again:\n");
        readLine(dest, size);
    }
}

int saveData() {
    FILE *f = fopen(DATA_FILE, "wb");
    if (f == NULL) {
        printf("Warning: could not save data to %s\n", DATA_FILE);
        return 0;
    }
    fwrite(&count, sizeof(int), 1, f);
    fwrite(Bank, sizeof(struct Accounts), count, f);
    fclose(f);
    return 1;
}

void loadData() {
    FILE *f = fopen(DATA_FILE, "rb");
    if (f == NULL) {
        printf("No saved data found. Starting with an empty bank.\n");
        return;
    }
    int saved = 0;
    if (fread(&saved, sizeof(int), 1, f) != 1 || saved < 0 || saved > MAX_ACCOUNTS) {
        printf("Saved data file is damaged. Starting with an empty bank.\n");
        fclose(f);
        return;
    }
    int read = fread(Bank, sizeof(struct Accounts), saved, f);
    fclose(f);
    if (read != saved) {
        printf("Saved data file is incomplete. Starting with an empty bank.\n");
        return;
    }
    count = saved;
    Available = MAX_ACCOUNTS - count;
    printf("Loaded %d account(s) from file.\n", count);
}

unsigned int hashPassword(const char *s) {
    unsigned int hash = 5381;
    int c;
    while ((c = (unsigned char)*s++) != 0) {
        hash = hash * 33 + c;
    }
    return hash;
}

int loadAdmin() {
    FILE *f = fopen(ADMIN_FILE, "rb");
    if (f == NULL) return 0;
    int ok = fread(&admin, sizeof(struct Admin), 1, f) == 1;
    fclose(f);
    return ok;
}
